# Sanity Studio variables are compiled into the browser application. They must
# contain public configuration only and must never contain API tokens or secrets.
SANITY_STUDIO_PROJECT_ID=nsznfiun
SANITY_STUDIO_DATASET=development
SANITY_STUDIO_API_VERSION=2026-09-01
SANITY_STUDIO_TITLE=KRUTIGER Content Studio (Development)

# Exact origin of the website loaded by the Presentation preview iframe.
# Use http://localhost:3000 locally and the approved deployment origin in the
# hosted Studio build. Do not include a locale path, query, or hash.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Public application identifier assigned by Sanity hosting.
SANITY_STUDIO_APP_ID=ubywro7on9gltov2bpy3eqml
