# Deployment origin only (no locale path, query, or hash).
# Local development safely falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# These identifiers and URLs are public configuration, not credentials.
NEXT_PUBLIC_SANITY_PROJECT_ID=nsznfiun
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# These values are server-only. Never add a NEXT_PUBLIC_ prefix.
# Create a Viewer token in Sanity Manage for authenticated draft reads and the
# Presentation Tool's short-lived preview URL validation.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Public production widget configuration for member login.
NEXT_PUBLIC_BSPORT_COMPANY_ID=6720
# Public production widget configuration for the calendar.
NEXT_PUBLIC_BSPORT_CALENDAR_COMPANY_ID=6720
# Public production widget configuration for memberships and pricing.
NEXT_PUBLIC_BSPORT_PRICING_COMPANY_ID=6720
# Public production widget configuration for the shop.
NEXT_PUBLIC_BSPORT_SHOP_COMPANY_ID=6720
# Public production widget configuration for gift cards.
NEXT_PUBLIC_BSPORT_GIFT_CARD_COMPANY_ID=6720
BSPORT_API_KEY=
